# UNIICHAT_THINKING for DeepSeek: off (never think), cut (the default for
# DeepSeek: no thinking for the first line, thinking when the model must cut
# a line that was too long), or a level (think on every call, as Anthropic).

_pi_key = {}


def pi_api_key(pi="pi", provider="anthropic"):
    """The key that pi stores for a provider, asked once per process and
    kept in memory only. None if pi has no key."""
    if provider not in _pi_key:
        key = None
        try:
            r = subprocess.run([pi, "auth", "print-api-key", "--provider",
                                provider], capture_output=True, text=True,
                               timeout=30)
            out = r.stdout.strip()
            if r.returncode == 0 and out and len(out.split()) == 1:
                key = out
        except (OSError, subprocess.TimeoutExpired):
            pass
        _pi_key[provider] = key
    return _pi_key[provider]


BACKENDS = ("agent", "auto", "api", "pi")


class Config:
    def __init__(self, env=None):
        """The compaction settings. By default (UNIICHAT_BACKEND=agent) no
        model is called and no key is looked up. The opt-in backends: api
        (the provider's own API), pi (`pi -p`), auto (api if a key is found,
        else pi). env=None reads the real environment, and asks pi for a key
        when the provider's key variable is unset. A given dict is used as
        it is. The provider is UNIICHAT_PROVIDER, else the one the
        UNIICHAT_MODEL name belongs to (claude..., deepseek...), else
        anthropic."""
        real = env is None
        env = os.environ if real else env
        model = env.get("UNIICHAT_MODEL") or ""
        provider = env.get("UNIICHAT_PROVIDER") or (
            "deepseek" if model.startswith("deepseek") else "anthropic")
        if provider not in PROVIDERS:
            raise Die("UNIICHAT_PROVIDER is anthropic or deepseek, not %s."
                      % provider)
        spec = PROVIDERS[provider]
        self.provider = provider
        self.model = model or spec["model"]
        self.thinking = env.get("UNIICHAT_THINKING") or spec["thinking"]
        if self.thinking not in THINKING and not (
                provider == "deepseek" and self.thinking == "cut"):
            raise Die("UNIICHAT_THINKING is one of: %s%s." % (
                " ".join(THINKING), " cut" if provider == "deepseek" else ""))
        want = env.get("UNIICHAT_BACKEND") or "agent"
        if want not in BACKENDS:
            raise Die("UNIICHAT_BACKEND is %s, not %s."
                      % (", ".join(BACKENDS), want))
        self.key = env.get(spec["key"])
        self.pi = env.get("UNIICHAT_PI") or "pi"
        if real and not self.key and want in ("auto", "api"):
            self.key = pi_api_key(self.pi, provider)
        self.timeout = int(env.get("UNIICHAT_TIMEOUT") or 300)
        self.api_url = (env.get(spec["url_env"]) or spec["url"]).rstrip("/")
        self.backend = ("api" if self.key else "pi") if want == "auto" else want
        if self.backend == "api" and not self.key:
            raise Die("UNIICHAT_BACKEND=api needs %s." % spec["key"])


class ApiBackend:
    """Anthropic Messages API, with the cache marks of the design."""

    def __init__(self, cfg, opener=urllib.request.urlopen):
        self.cfg, self.opener = cfg, opener

    def conversation(self, system, chat_lines, task):
        return ApiConversation(self, system, chat_lines, task)


class ApiConversation:
    def __init__(self, backend, system, chat_lines, task):
        self.b, self.system = backend, system
        self.messages = [{"role": "user",
                          "content": render_blocks(chat_lines, task)}]
        self.usage = {"hit": 0, "miss": 0, "out": 0, "calls": 0}

    def _send(self):
        cfg = self.b.cfg
        budget = THINKING.get(cfg.thinking, 0)
        body = {"model": cfg.model, "max_tokens": budget + 2048,
                "system": self.system, "messages": self.messages}
        if budget:
            body["thinking"] = {"type": "enabled", "budget_tokens": budget}
        req = urllib.request.Request(
            cfg.api_url + "/v1/messages", json.dumps(body).encode(),
            {"content-type": "application/json", "x-api-key": cfg.key,
             "anthropic-version": "2023-06-01"})
        try:
            with self.b.opener(req, timeout=cfg.timeout) as r:
                data = json.load(r)
        except (urllib.error.URLError, OSError, ValueError) as e:
            raise ModelError("API call failed: %s" % e)
        text = "".join(c.get("text", "") for c in data.get("content", [])
                       if c.get("type") == "text")
        u = data.get("usage") or {}
        self.usage["hit"] += u.get("cache_read_input_tokens", 0)
        self.usage["miss"] += (u.get("input_tokens", 0)
                               + u.get("cache_creation_input_tokens", 0))
        self.usage["out"] += u.get("output_tokens", 0)
        self.usage["calls"] += 1
        self.messages.append({"role": "assistant", "content": text})
        return text

    def ask(self):
        return self._send()

    def followup(self, user):
        for m in self.messages[:-1]:  # only the end of the request is marked
            if m["role"] == "user" and isinstance(m["content"], list):
                m["content"][-1].pop("cache_control", None)
        self.messages.append({"role": "user", "content": [
            {"type": "text", "text": user,
             "cache_control": {"type": "ephemeral"}}]})
        return self._send()

    def close(self):
        pass


class DeepSeekBackend:
    """DeepSeek's chat API (direct, OpenAI format). The request is the system
    prompt, then the view and the task as one user message, so the prefix
    stays the same from call to call and DeepSeek caches it by itself. No
    cache marks: this API has none."""

    def __init__(self, cfg, opener=urllib.request.urlopen):
        self.cfg, self.opener = cfg, opener

    def conversation(self, system, chat_lines, task):
        return DeepSeekConversation(self, system, chat_lines, task)


class DeepSeekConversation:
    def __init__(self, backend, system, chat_lines, task):
        self.b = backend
        self.messages = [
            {"role": "system", "content": system},
            {"role": "user", "content": "".join(
                b["text"] for b in render_blocks(chat_lines, task))}]
        self.usage = {"hit": 0, "miss": 0, "out": 0, "calls": 0}

    def _post(self, thinking_on):
        cfg = self.b.cfg
        body = {"model": cfg.model, "messages": self.messages}
        if thinking_on:
            level = cfg.thinking if cfg.thinking in THINKING else "high"
            body["thinking"] = {"type": "enabled"}
            body["reasoning_effort"] = ("max" if level in ("xhigh", "max")
                                        else "high")
            body["max_tokens"] = DEEPSEEK_LINE_TOKENS + THINKING[level]
        else:
            body["thinking"] = {"type": "disabled"}
            body["max_tokens"] = DEEPSEEK_LINE_TOKENS
        req = urllib.request.Request(
            cfg.api_url + "/chat/completions", json.dumps(body).encode(),
            {"content-type": "application/json",
             "authorization": "Bearer " + cfg.key})
        try:
            with self.b.opener(req, timeout=cfg.timeout) as r:
                data = json.load(r)
            choice = data["choices"][0]
            text = choice["message"].get("content") or ""
        except (urllib.error.URLError, OSError, ValueError, KeyError,
                IndexError, TypeError) as e:
            raise ModelError("API call failed: %s" % e)
        u = data.get("usage") or {}
        self.usage["hit"] += u.get("prompt_cache_hit_tokens", 0)
        self.usage["miss"] += u.get("prompt_cache_miss_tokens", 0)
        self.usage["out"] += u.get("completion_tokens", 0)
        self.usage["calls"] += 1
        return text.strip()

    def _send(self, first):
        mode = self.b.cfg.thinking
        on = mode != "off" and (mode != "cut" or not first)
        text = self._post(on)
        if not text and on:  # thinking used every token: ask again without it
            text = self._post(False)
        self.messages.append({"role": "assistant", "content": text})
        return text

    def ask(self):
        return self._send(True)

    def followup(self, user):
        self.messages.append({"role": "user", "content": user})
        return self._send(False)

    def close(self):
        pass


class PiBackend:
    """The same call through `pi --no-extensions -p`: no cache marks."""

    def __init__(self, cfg):
        self.cfg = cfg

    def conversation(self, system, chat_lines, task):
        return PiConversation(self.cfg, system, chat_lines, task)


class PiConversation:
    def __init__(self, cfg, system, chat_lines, task):
        self.cfg, self.system = cfg, system
        self.prompt = "".join(b["text"]
                              for b in render_blocks(chat_lines, task))
        self.dir, self.first = tempfile.mkdtemp(prefix="memo-pi-"), True

    def _run(self, text):
        c = self.cfg
        thinking = c.thinking  # cut: think only to cut a line that was too long
        if thinking == "cut":
            thinking = "off" if self.first else "high"
        cmd = [c.pi, "--no-extensions", "--no-skills", "--no-context-files",
               "--no-tools", "--no-mcp", "--no-prompt-templates",
               "--no-themes", "--provider", c.provider, "--model", c.model,
               "--thinking", thinking, "--session-dir", self.dir]
        if not self.first:
            cmd.append("--continue")
        cmd += ["--system-prompt", self.system, "-p"]
        env = {k: v for k, v in os.environ.items()
               if k not in ("PI_SESSION_FILE", "PI_SESSION_ID")}
        try:
            r = subprocess.run(cmd, input=text, capture_output=True,
                               text=True, timeout=c.timeout, env=env)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise ModelError("pi failed: %s" % e)
        if r.returncode:
            raise ModelError("pi exited %d: %s" % (r.returncode,
                                                   r.stderr.strip()[-300:]))
        self.first = False
        return r.stdout.strip()

    def ask(self):
        return self._run(self.prompt)

    def followup(self, user):
        return self._run(user)

    def close(self):
        import shutil
        shutil.rmtree(self.dir, ignore_errors=True)


def make_backend(cfg):
    if cfg.backend == "agent":
        raise Die("The agent writes the lines: run `%s task`. To use a model, "
                  "set UNIICHAT_BACKEND=api or pi." % ME)
    if cfg.backend == "pi":
        return PiBackend(cfg)
    return (DeepSeekBackend(cfg) if cfg.provider == "deepseek"
            else ApiBackend(cfg))


def clean(reply):
    line = one_line(reply).strip()
    return re.sub(r"^\d+\+\d+\|\s*", "", line)


def run_job(backend, job):
    """One compaction: the ruler is in the task; a reply over 512 bytes gets
    the cut, in the same conversation, up to TRIES tries. Keeps the shortest
    line: a few bytes over is fine."""
    conv = backend.conversation(SYSTEM_PROMPT, job["chat"], job["task"])
    best = None
    try:
        reply = conv.ask()
        for attempt in range(TRIES):
            line = clean(reply)
            if not line:
                raise ModelError("empty reply")
            if best is None or nbytes(line) < nbytes(best):
                best = line
            if nbytes(line) <= NODE_MAX or attempt == TRIES - 1:
                break
            cut = line.encode()[:NODE_MAX].decode("utf-8", "ignore")
            reply = conv.followup(TOO_LONG.format(n=nbytes(line), cut=cut))
    finally:
        conv.close()
    return best


def task_text(store, key, chat=True):
    """The task of one compaction, as the design words it, and the id of the
    message after its last one. With chat=False the task does not mention
    the <chat> block (the agent reads the view with `wake`)."""
    l, i = key
    if l == 0:
        m = store.main.get(i)
        task = ("Compaction: compress message %d into one line of at most 512 "
                "bytes\n(about 70 words), the length of this ruler:\n%s\n"
                "<input>\n%s: %s\n</input>\n" % (i, RULER, m["kind"], m["text"]))
        return task, i
    a, b = store.tree.get(l - 1, 2 * i), store.tree.get(l - 1, 2 * i + 1)
    first, last = i << l, ((i + 1) << l) - 1
    more = ("<chat> may hold their messages, %d to %d, in more detail: take "
            "details\nof them from there too.\n" % (first, last)) if chat else ""
    task = ("Compaction: merge lines %s and %s, adjacent, into one line of at "
            "most\n512 bytes (about 70 words), the length of this "
            "ruler:\n%s\n%s<input>\n%s\n%s\n</input>\n"
            % (line_id(l - 1, 2 * i), line_id(l - 1, 2 * i + 1), RULER, more,
               a, b))
    return task, last + 1


def make_job(store, s, key):
    task, end = task_text(store, key)
    return {"key": key, "task": task, "chat": store.compaction_view(s, end)}


def compact(store, backend, log=lambda m: None, max_calls=MAX_CALLS,
            sleep_for=None):
    """Build every ready node. Up to max_calls model calls at once. The
    queues say what is ready; the tree is never scanned. Returns
    (built, failed). A failed node stays queued for the next call."""
    lock = open(store.p(".worker.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        log("another worker is running")
        return 0, 0
    built, failed, flight = 0, set(), {}
    try:
        with concurrent.futures.ThreadPoolExecutor(max_calls) as pool:
            while True:
                s = store.load()
                todo = [(0, i) for i in s.msgs[:MAX_CALLS]] + list(s.merges)
                for key in todo:
                    if len(flight) >= max_calls:
                        break
                    if key in failed or key in flight.values():
                        continue
                    job = make_job(store, s, key)
                    flight[pool.submit(run_job, backend, job)] = key
                if not flight:
                    break
                done, _ = concurrent.futures.wait(
                    flight, return_when=concurrent.futures.FIRST_COMPLETED)
                for f in done:
                    key = flight.pop(f)
                    try:
                        text = f.result()
                    except Exception as e:  # one failed call never stops the rest
                        failed.add(key)
                        log("failed %s: %s" % (line_id(*key), e))
                        continue
                    store.commit(key, text)
                    built += 1
                    log("built %s" % line_id(*key))
    finally:
        lock.close()
    if failed:
        open(store.p(".worker-failed"), "w").close()
    return built, len(failed)


