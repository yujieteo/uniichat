        raise Die("usage: %s init" % ME)
    fresh = not store.exists()
    store.init()
    out("%s %s." % ("Created" if fresh else "Found", pretty(store.path)))


GUIDE = """\
Memory view: the whole chat, oldest first, one summary line per node: id+n|text
is the n messages from id on. Recent lines are fine, old lines coarse.
When a line is too vague, open it: `memo zoom ID N` (its two halves; N=1 gives
message ID whole). `memo date ID` gives its date. Zoom is the way to navigate.
Log the session: `memo user "..."` for each user prompt, `memo unii "..."` for
your reply, `memo note "..."` for what is worth keeping. If memo asks for a
compaction, do it before your next action (`memo line ID+N "..."`)."""


def cmd_wake(store, args, out):
    need_store(store)
    with store.writer():
        store.catch_up()
    s = store.load()
    start = 0
    if args:
        if len(args) != 2 or not all(a.isdigit() for a in args):
            raise Die("usage: %s wake [FROM EPOCH]" % ME)
        start = int(args[0])
        if int(args[1]) != s.epoch:
            raise Die("The view changed. Run: %s wake" % ME)
    lines = [store.render(l, i) for l, i in s.chat]
    if start == 0:
        show_offer(store, out, 3)
        out(GUIDE)
        out("<chat>")
    k, size = start, 0
    while k < len(lines) and (k == start or size + nbytes(lines[k]) + 1
                              <= WAKE_PART):
        out(lines[k])
        size += nbytes(lines[k]) + 1
        k += 1
    if k < len(lines):
        out("Not awake yet. Run: %s wake %d %d" % (ME, k, s.epoch))
    else:
        out("</chat>")


def cmd_note(store, args, out, kind=None):
    """note [--kind K] [TEXT|-]. For kind user or unii (a session's own log)
    the text is redacted and gets the source mark of the session; nothing is
    saved in a worker session, or in a session that a capture hook follows."""
    need_store(store)
    name = "note" if kind is None else kind
    usage = ("usage: %s note [--kind K] [TEXT|-]" % ME if kind is None
             else "usage: %s %s [TEXT|-]" % (ME, kind))
    rest = list(args)
    if kind is None:
        kind = "note"
        if rest[:1] == ["--kind"]:
            if len(rest) < 2:
                raise Die(usage)
            kind, rest = rest[1], rest[2:]
    if kind not in KINDS:
        raise Die("Kind %s is not one of: %s." % (kind, " ".join(KINDS)))
    if len(rest) != 1:
        raise Die(usage)
    text = sys.stdin.read() if rest[0] == "-" else rest[0]
    text = text.rstrip("\n") if rest[0] == "-" else text
    if not text.strip():
        raise Die("Empty. A message needs text.")
    if kind in ("user", "unii"):
        who = session_from_env()
        if any(os.environ.get(v) for v in SKIP_ENV):
            out("Not saved: this is a worker session.")
            return
        if who and Cursors(store).has_session(*who):
            out("Not saved: the capture hook of this session logs it.")
            return
        text = redact(text)
        if who:
            text = "[%s %s] %s" % (who[0], sha(who[1], 4), text)
    with store.writer():
        base = store.add_messages(make_items(kind, text))
        last = store.main.count() - 1
    out("Saved as #%d." % base if last == base
        else "Saved as #%d to #%d." % (base, last))
    show_offer(store, out, 1)


def cmd_zoom(store, args, out):
    need_store(store)
    if len(args) != 2 or not all(a.isdigit() for a in args):
        raise Die("usage: %s zoom ID N   # a line id+n of the view" % ME)
    i, n = int(args[0]), int(args[1])
    T = store.main.count()
    if n < 1 or n & (n - 1) or i % n:
        raise Die("%d+%d is not a line: N is a power of 2, ID a multiple "
                  "of N." % (i, n))
    if i + n > T:
        raise Die("%d+%d is beyond the chat: it holds %d messages." % (i, n, T))
    if n == 1:
        m = store.main.get(i)
        out("%s: %s" % (m["kind"], m["text"]))
        return
    l = n.bit_length() - 2
    for c in (2 * (i >> (l + 1)), 2 * (i >> (l + 1)) + 1):
        out(store.render(l, c))


def cmd_date(store, args, out):
    need_store(store)
    if len(args) != 1 or not args[0].isdigit():
        raise Die("usage: %s date ID" % ME)
    out(store.main.get(int(args[0]))["date"])


def cmd_compact(store, args, out, backend=None):
    need_store(store)
    if args:
        raise Die("usage: %s compact" % ME)
