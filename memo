    out("compaction %d lines, %d bytes%s" % (
        len(s.compact), sum(store.size(*k) for k in s.compact),
        ", merging" if s.compact_merging else ""))
    if cfg.backend == "agent":
        out("compactor  the agent (memo task, memo line); no model is called")
    else:
        out("compactor  %s (%s) via %s, thinking %s" % (
            cfg.model, cfg.provider, cfg.backend, cfg.thinking))
    cdir = store.p("capture")
