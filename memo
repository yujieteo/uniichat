_pi_key = []


def pi_api_key(pi="pi"):
    """The Anthropic key that pi stores, asked once per process and kept
    in memory only. None if pi has no key."""
    if not _pi_key:
        key = None
        try:
            r = subprocess.run([pi, "auth", "print-api-key", "--provider",
                                "anthropic"], capture_output=True, text=True,
                               timeout=30)
            out = r.stdout.strip()
            if r.returncode == 0 and out and len(out.split()) == 1:
                key = out
        except (OSError, subprocess.TimeoutExpired):
            pass
        _pi_key.append(key)
    return _pi_key[0]


class Config:
    def __init__(self, env=None):
        """env=None reads the real environment, and asks pi for a key when
        ANTHROPIC_API_KEY is unset. A given dict is used as it is."""
        real = env is None
        env = os.environ if real else env
        self.model = env.get("UNIICHAT_MODEL") or DEFAULT_MODEL
        self.thinking = env.get("UNIICHAT_THINKING") or "xhigh"
        self.key = env.get("ANTHROPIC_API_KEY")
        self.pi = env.get("UNIICHAT_PI") or "pi"
        if real and not self.key and env.get("UNIICHAT_BACKEND") != "pi":
            self.key = pi_api_key(self.pi)
        self.timeout = int(env.get("UNIICHAT_TIMEOUT") or 300)
        self.api_url = (env.get("ANTHROPIC_BASE_URL")
                        or "https://api.anthropic.com").rstrip("/")
        want = env.get("UNIICHAT_BACKEND") or "auto"
        if want not in ("auto", "api", "pi"):
            raise Die("UNIICHAT_BACKEND is auto, api or pi, not %s." % want)
        self.backend = ("api" if self.key else "pi") if want == "auto" else want
        if self.backend == "api" and not self.key:
            raise Die("UNIICHAT_BACKEND=api needs ANTHROPIC_API_KEY.")


class ApiBackend:
    """Anthropic Messages API, with the cache marks of the design."""

    def __init__(self, cfg, opener=urllib.request.urlopen):
        self.cfg, self.opener = cfg, opener

    def conversation(self, system, chat_lines, task):
        return ApiConversation(self, system, chat_lines, task)


class ApiConversation:
    def __init__(self, backend, system, chat_lines, task):
        self.b, self.system = backend, system
        self.messages = [{"role": "user",
                          "content": render_blocks(chat_lines, task)}]

    def _send(self):
        cfg = self.b.cfg
        budget = THINKING.get(cfg.thinking, 0)
        body = {"model": cfg.model, "max_tokens": budget + 2048,
                "system": self.system, "messages": self.messages}
        if budget:
            body["thinking"] = {"type": "enabled", "budget_tokens": budget}
        req = urllib.request.Request(
            cfg.api_url + "/v1/messages", json.dumps(body).encode(),
            {"content-type": "application/json", "x-api-key": cfg.key,
             "anthropic-version": "2023-06-01"})
        try:
            with self.b.opener(req, timeout=cfg.timeout) as r:
                data = json.load(r)
        except (urllib.error.URLError, OSError, ValueError) as e:
            raise ModelError("API call failed: %s" % e)
        text = "".join(c.get("text", "") for c in data.get("content", [])
                       if c.get("type") == "text")
        self.messages.append({"role": "assistant", "content": text})
        return text

    def ask(self):
        return self._send()

    def followup(self, user):
        for m in self.messages[:-1]:  # only the end of the request is marked
            if m["role"] == "user" and isinstance(m["content"], list):
                m["content"][-1].pop("cache_control", None)
        self.messages.append({"role": "user", "content": [
            {"type": "text", "text": user,
             "cache_control": {"type": "ephemeral"}}]})
        return self._send()

    def close(self):
        pass


class PiBackend:
    """The same call through `pi --no-extensions -p`: no cache marks."""

    def __init__(self, cfg):
        self.cfg = cfg

    def conversation(self, system, chat_lines, task):
        return PiConversation(self.cfg, system, chat_lines, task)


class PiConversation:
    def __init__(self, cfg, system, chat_lines, task):
        self.cfg, self.system = cfg, system
        self.prompt = "".join(b["text"]
                              for b in render_blocks(chat_lines, task))
        self.dir, self.first = tempfile.mkdtemp(prefix="memo-pi-"), True

    def _run(self, text):
        c = self.cfg
        cmd = [c.pi, "--no-extensions", "--no-skills", "--no-context-files",
               "--no-tools", "--no-mcp", "--no-prompt-templates",
               "--no-themes", "--provider", "anthropic", "--model", c.model,
               "--thinking", c.thinking, "--session-dir", self.dir]
        if not self.first:
            cmd.append("--continue")
        cmd += ["--system-prompt", self.system, "-p"]
        env = {k: v for k, v in os.environ.items()
               if k not in ("PI_SESSION_FILE", "PI_SESSION_ID")}
        try:
            r = subprocess.run(cmd, input=text, capture_output=True,
                               text=True, timeout=c.timeout, env=env)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise ModelError("pi failed: %s" % e)
        if r.returncode:
            raise ModelError("pi exited %d: %s" % (r.returncode,
                                                   r.stderr.strip()[-300:]))
        self.first = False
        return r.stdout.strip()

    def ask(self):
        return self._run(self.prompt)

    def followup(self, user):
        return self._run(user)

    def close(self):
        import shutil
        shutil.rmtree(self.dir, ignore_errors=True)


def make_backend(cfg):
    return ApiBackend(cfg) if cfg.backend == "api" else PiBackend(cfg)


def clean(reply):
    line = one_line(reply).strip()
    return re.sub(r"^\d+\+\d+\|\s*", "", line)


def run_job(backend, job):
    """One compaction: the ruler is in the task; a reply over 512 bytes gets
    the cut, in the same conversation, up to TRIES tries. Keeps the shortest
    line: a few bytes over is fine."""
    conv = backend.conversation(SYSTEM_PROMPT, job["chat"], job["task"])
    best = None
    try:
        reply = conv.ask()
        for attempt in range(TRIES):
            line = clean(reply)
            if not line:
                raise ModelError("empty reply")
            if best is None or nbytes(line) < nbytes(best):
                best = line
            if nbytes(line) <= NODE_MAX or attempt == TRIES - 1:
                break
            cut = line.encode()[:NODE_MAX].decode("utf-8", "ignore")
            reply = conv.followup(TOO_LONG.format(n=nbytes(line), cut=cut))
    finally:
        conv.close()
    return best


def make_job(store, s, key):
    l, i = key
    if l == 0:
        m = store.main.get(i)
        task = ("Compaction: compress message %d into one line of at most 512 "
                "bytes\n(about 70 words), the length of this ruler:\n%s\n"
                "<input>\n%s: %s\n</input>\n" % (i, RULER, m["kind"], m["text"]))
        end = i
    else:
        a, b = store.tree.get(l - 1, 2 * i), store.tree.get(l - 1, 2 * i + 1)
        first, last = i << l, ((i + 1) << l) - 1
        task = ("Compaction: merge lines %s and %s, adjacent, into one line of "
                "at most\n512 bytes (about 70 words), the length of this "
                "ruler:\n%s\n<chat> may hold their messages, %d to %d, in more "
                "detail: take details\nof them from there too.\n<input>\n%s\n"
                "%s\n</input>\n" % (line_id(l - 1, 2 * i),
                                    line_id(l - 1, 2 * i + 1), RULER,
                                    first, last, a, b))
        end = last + 1
    return {"key": key, "task": task, "chat": store.compaction_view(s, end)}


def compact(store, backend, log=lambda m: None, max_calls=MAX_CALLS,
            sleep_for=None):
    """Build every ready node. Up to max_calls model calls at once. The
    queues say what is ready; the tree is never scanned. Returns
    (built, failed). A failed node stays queued for the next call."""
    lock = open(store.p(".worker.lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        log("another worker is running")
        return 0, 0
    built, failed, flight = 0, set(), {}
    try:
        with concurrent.futures.ThreadPoolExecutor(max_calls) as pool:
            while True:
                s = store.load()
                todo = [(0, i) for i in s.msgs[:MAX_CALLS]] + list(s.merges)
                for key in todo:
                    if len(flight) >= max_calls:
                        break
                    if key in failed or key in flight.values():
                        continue
                    job = make_job(store, s, key)
                    flight[pool.submit(run_job, backend, job)] = key
                if not flight:
                    break
                done, _ = concurrent.futures.wait(
                    flight, return_when=concurrent.futures.FIRST_COMPLETED)
                for f in done:
                    key = flight.pop(f)
                    try:
                        text = f.result()
                    except Exception as e:  # one failed call never stops the rest
                        failed.add(key)
                        log("failed %s: %s" % (line_id(*key), e))
                        continue
                    store.commit(key, text)
                    built += 1
                    log("built %s" % line_id(*key))
    finally:
        lock.close()
    if failed:
        open(store.p(".worker-failed"), "w").close()
    return built, len(failed)


# ------------------------------------------------------------ commands

def need_store(store):
    if not store.exists():
        raise Die("No chat at %s.\nTo create one, run: %s init" %
                  (pretty(store.path), ME))


def cmd_init(store, args, out):
    if args:
        raise Die("usage: %s init" % ME)
    fresh = not store.exists()
    store.init()
    out("%s %s." % ("Created" if fresh else "Found", pretty(store.path)))


GUIDE = """\
Memory view: the whole chat, oldest first, one summary line per node: id+n|text
is the n messages from id on. Recent lines are fine, old lines coarse.
When a line is too vague, open it: `memo zoom ID N` (its two halves; N=1 gives
message ID whole). `memo date ID` gives its date. Zoom is the way to navigate.
Record something worth keeping with `memo note "..."`."""


def cmd_wake(store, args, out):
    need_store(store)
    with store.writer():
        store.catch_up()
    s = store.load()
    start = 0
    if args:
        if len(args) != 2 or not all(a.isdigit() for a in args):
            raise Die("usage: %s wake [FROM EPOCH]" % ME)
        start = int(args[0])
        if int(args[1]) != s.epoch:
            raise Die("The view changed. Run: %s wake" % ME)
    lines = [store.render(l, i) for l, i in s.chat]
    if start == 0:
        out(GUIDE)
        out("<chat>")
    k, size = start, 0
    while k < len(lines) and (k == start or size + nbytes(lines[k]) + 1
                              <= WAKE_PART):
        out(lines[k])
        size += nbytes(lines[k]) + 1
        k += 1
    if k < len(lines):
        out("Not awake yet. Run: %s wake %d %d" % (ME, k, s.epoch))
    else:
        out("</chat>")


def cmd_note(store, args, out):
    need_store(store)
    kind, rest = "note", list(args)
    if rest[:1] == ["--kind"]:
        if len(rest) < 2:
            raise Die("usage: %s note [--kind K] [TEXT|-]" % ME)
        kind, rest = rest[1], rest[2:]
    if kind not in KINDS:
        raise Die("Kind %s is not one of: %s." % (kind, " ".join(KINDS)))
    if len(rest) != 1:
        raise Die("usage: %s note [--kind K] [TEXT|-]" % ME)
    text = sys.stdin.read() if rest[0] == "-" else rest[0]
    text = text.rstrip("\n") if rest[0] == "-" else text
    if not text.strip():
        raise Die("Empty. A message needs text.")
    with store.writer():
        base = store.add_messages(make_items(kind, text))
        last = store.main.count() - 1
    out("Saved as #%d." % base if last == base
        else "Saved as #%d to #%d." % (base, last))


def cmd_zoom(store, args, out):
    need_store(store)
    if len(args) != 2 or not all(a.isdigit() for a in args):
        raise Die("usage: %s zoom ID N   # a line id+n of the view" % ME)
    i, n = int(args[0]), int(args[1])
    T = store.main.count()
    if n < 1 or n & (n - 1) or i % n:
        raise Die("%d+%d is not a line: N is a power of 2, ID a multiple "
                  "of N." % (i, n))
    if i + n > T:
        raise Die("%d+%d is beyond the chat: it holds %d messages." % (i, n, T))
    if n == 1:
        m = store.main.get(i)
        out("%s: %s" % (m["kind"], m["text"]))
        return
    l = n.bit_length() - 2
    for c in (2 * (i >> (l + 1)), 2 * (i >> (l + 1)) + 1):
        out(store.render(l, c))


def cmd_date(store, args, out):
    need_store(store)
    if len(args) != 1 or not args[0].isdigit():
        raise Die("usage: %s date ID" % ME)
    out(store.main.get(int(args[0]))["date"])


def cmd_compact(store, args, out, backend=None):
    need_store(store)
    if args:
        raise Die("usage: %s compact" % ME)
    with store.writer():
        store.catch_up()
    backend = backend or make_backend(Config())
    built, failed = compact(store, backend, log=lambda m: out(m))
    left = len(store.load().msgs) + len(store.load().merges)
    out("Built %d. %d pending, %d failed." % (built, left, failed))


def cmd_status(store, args, out):
    need_store(store)
    s = store.load()
    cfg = Config()
    out("messages   %d" % store.main.count())
    out("queue      %d messages, %d merges ready" % (len(s.msgs), len(s.merges)))
    out("view       %d lines, %d bytes%s (epoch %d)" % (
        len(s.chat), sum(store.size(*k) for k in s.chat),
        ", merging" if s.chat_merging else "", s.epoch))
    out("compaction %d lines, %d bytes%s" % (
        len(s.compact), sum(store.size(*k) for k in s.compact),
        ", merging" if s.compact_merging else ""))
    out("model      %s via %s, thinking %s" % (cfg.model, cfg.backend,
                                              cfg.thinking))
    out("store      %s" % pretty(store.path))


OLD_RECORD = re.compile(r"#(\d+) (\d{4}-\d{2}-\d{2}) (.*)")


def read_old_log(path):
    """The memories of an old OptMem LOG.txt: [(date, text)] in order."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = [ln.rstrip() for ln in f if ln.strip()]
    except (OSError, UnicodeDecodeError) as e:
        raise Die("Cannot read %s: %s" % (path, e))
    out = []
    for n, ln in enumerate(lines):
        m = OLD_RECORD.fullmatch(ln)
        if not m or int(m.group(1)) != n:
            raise Die("%s: record %d is not '#%d YYYY-MM-DD text'." %
                      (path, n, n))
        out.append((m.group(2), m.group(3)))
    return out


def cmd_import(store, args, out):
    need_store(store)
    if len(args) > 1:
        raise Die("usage: %s import [LOG.txt]" % ME)
    src = args[0] if args else store.p("LOG.txt")
    old = read_old_log(src)
    if not old:
        raise Die("%s has no memories." % src)
    with store.writer():
        have = store.main.count()
        if have > len(old):
            raise Die("The chat holds %d messages: more than the %d to import."
                      % (have, len(old)))
        for k in range(have):
            m = store.main.get(k)
            if (m["kind"], m["text"], m["date"]) != ("note", old[k][1],
                                                     old[k][0]):
                raise Die("Message #%d differs from memory #%d: import goes "
                          "into an empty chat." % (k, k))
        items = []
        for date, text in old[have:]:
            items += make_items("note", text, date)
        if items:
            store.add_messages(items)
    out("Imported %d memories as notes #%d to #%d. Run: %s compact"
        % (len(old) - have, have, len(old) - 1, ME))


COMMANDS = {"init": cmd_init, "wake": cmd_wake, "note": cmd_note,
            "zoom": cmd_zoom, "date": cmd_date, "compact": cmd_compact,
            "status": cmd_status, "import": cmd_import}
NO_WORKER = ("init", "compact", "status")


def default_store():
    return os.path.expanduser(os.environ.get("UNIICHAT_DIR")
                              or "~/.uniichat/chat")


def kick_worker(store):
    """Start a background `memo compact` when summaries are pending: the
    next call after a note. Skips if one runs or one failed a minute ago."""
    if os.environ.get("UNIICHAT_NO_WORKER"):
        return
    s = store.load()
    if not (s.msgs or s.merges):
        return
    try:
        if time.time() - os.path.getmtime(store.p(".worker-failed")) < 60:
            return
    except FileNotFoundError:
        pass
    probe = open(store.p(".worker.lock"), "a")
    try:
        fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    finally:
        probe.close()
    log = open(store.p("worker.log"), "ab")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--store",
                      store.path, "compact"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True)


def main(argv=None, out=print, clock=now):
    argv = list(sys.argv[1:] if argv is None else argv)
    path = default_store()
    try:
        if argv[:1] == ["--store"]:
            if len(argv) < 2:
                raise Die("usage: %s --store PATH COMMAND" % ME)
            path, argv = os.path.expanduser(argv[1]), argv[2:]
        if not argv or argv[0] not in COMMANDS:
            if argv and argv[0] not in ("-h", "--help"):
                print("No such command: %s\n" % argv[0], file=sys.stderr)
                print(__doc__.strip(), file=sys.stderr)
                return 1
            out(__doc__.strip())
            return 0
        store = Store(path, clock)
        COMMANDS[argv[0]](store, argv[1:], out)
        if argv[0] not in NO_WORKER and store.exists():
            kick_worker(store)
    except Die as e:
        print(e, file=sys.stderr)
        return 1
    except OSError as e:
        print("%s: %s." % (pretty(e.filename or path), e.strerror or e),
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
