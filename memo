def cmd_status(store, args, out):
    need_store(store)
    s = store.load()
    cfg = Config()
    out("messages   %d" % store.main.count())
    out("queue      %d messages, %d merges ready" % (len(s.msgs), len(s.merges)))
    out("view       %d lines, %d bytes%s (epoch %d)" % (
        len(s.chat), sum(store.size(*k) for k in s.chat),
