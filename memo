    out("capture    %d session files followed, %d queued, %d error lines"
        % (sessions, queued, errors))
    out("store      %s" % pretty(store.path))


OLD_RECORD = re.compile(r"#(\d+) (\d{4}-\d{2}-\d{2}) (.*)")


def read_old_log(path):
    """The memories of an old OptMem LOG.txt: [(date, text)] in order."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = [ln.rstrip() for ln in f if ln.strip()]
    except (OSError, UnicodeDecodeError) as e:
        raise Die("Cannot read %s: %s" % (path, e))
    out = []
    for n, ln in enumerate(lines):
        m = OLD_RECORD.fullmatch(ln)
        if not m or int(m.group(1)) != n:
            raise Die("%s: record %d is not '#%d YYYY-MM-DD text'." %
                      (path, n, n))
        out.append((m.group(2), m.group(3)))
    return out


def cmd_import(store, args, out):
    need_store(store)
    if len(args) > 1:
        raise Die("usage: %s import [LOG.txt]" % ME)
    src = args[0] if args else store.p("LOG.txt")
    old = read_old_log(src)
    if not old:
        raise Die("%s has no memories." % src)
    with store.writer():
        have = store.main.count()
        if have > len(old):
            raise Die("The chat holds %d messages: more than the %d to import."
                      % (have, len(old)))
        for k in range(have):
            m = store.main.get(k)
            if (m["kind"], m["text"], m["date"]) != ("note", old[k][1],
                                                     old[k][0]):
                raise Die("Message #%d differs from memory #%d: import goes "
                          "into an empty chat." % (k, k))
        items = []
        for date, text in old[have:]:
            items += make_items("note", text, date)
        if items:
            store.add_messages(items)
    out("Imported %d memories as notes #%d to #%d. Run: %s compact"
        % (len(old) - have, have, len(old) - 1, ME))


COMMANDS = {"init": cmd_init, "wake": cmd_wake, "note": cmd_note,
            "zoom": cmd_zoom, "date": cmd_date, "compact": cmd_compact,
            "status": cmd_status, "import": cmd_import, "capture": cmd_capture,
            "task": cmd_task, "line": cmd_line,
            "user": lambda st, a, o: cmd_note(st, a, o, "user"),
            "unii": lambda st, a, o: cmd_note(st, a, o, "unii")}
NO_WORKER = ("init", "compact", "status")


def default_store():
    return os.path.expanduser(os.environ.get("UNIICHAT_DIR")
                              or "~/.uniichat/chat")


def kick_worker(store):
    """Start a background `memo compact` when summaries are pending: the
    next call after a note. Skips if one runs or one failed a minute ago."""
    if os.environ.get("UNIICHAT_NO_WORKER") or agent_mode():
        return
    s = store.load()
    if not (s.msgs or s.merges):
        return
    try:
        if time.time() - os.path.getmtime(store.p(".worker-failed")) < 60:
            return
    except FileNotFoundError:
        pass
    probe = open(store.p(".worker.lock"), "a")
    try:
        fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    finally:
        probe.close()
    log = open(store.p("worker.log"), "ab")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--store",
                      store.path, "compact"], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True)


def main(argv=None, out=print, clock=now):
    argv = list(sys.argv[1:] if argv is None else argv)
    path = default_store()
    try:
        if argv[:1] == ["--store"]:
            if len(argv) < 2:
                raise Die("usage: %s --store PATH COMMAND" % ME)
            path, argv = os.path.expanduser(argv[1]), argv[2:]
        if not argv or argv[0] not in COMMANDS:
            if argv and argv[0] not in ("-h", "--help"):
                print("No such command: %s\n" % argv[0], file=sys.stderr)
                print(__doc__.strip(), file=sys.stderr)
                return 1
            out(__doc__.strip())
            return 0
        store = Store(path, clock)
        COMMANDS[argv[0]](store, argv[1:], out)
        if argv[0] not in NO_WORKER and store.exists():
            kick_worker(store)
    except Die as e:
        print(e, file=sys.stderr)
        return 1
    except OSError as e:
        print("%s: %s." % (pretty(e.filename or path), e.strerror or e),
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
