class DayFile:
    """One append-only jsonl file, read incrementally. A trailing line with
    no newline is a crashed write: readers skip it, the writer cuts it."""

    def __init__(self, path):
        self.path, self.offset, self.records = path, 0, []

    def refresh(self):
        try:
            if os.path.getsize(self.path) == self.offset:
                return []
            with open(self.path, "rb") as f:
                f.seek(self.offset)
                data = f.read()
        except FileNotFoundError:
            return []
        end = data.rfind(b"\n") + 1
        new = [json.loads(line) for line in data[:end].splitlines() if line]
        self.offset += end
        self.records += new
        return new

    def append(self, recs):
        """Append and flush; the caller holds the writer lock."""
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        try:
            size = os.path.getsize(self.path)
        except FileNotFoundError:
            size = 0
        if size:
            with open(self.path, "rb") as r:
                data = r.read()
            if not data.endswith(b"\n"):
                os.truncate(self.path, data.rfind(b"\n") + 1)
        with open(self.path, "ab") as f:
            for rec in recs:
                f.write((json.dumps(rec, ensure_ascii=False,
                                    separators=(",", ":")) + "\n").encode())
            f.flush()
            os.fsync(f.fileno())
        self.refresh()


class Main:
    """main/YYYY-MM-DD.jsonl: messages {i, kind, text, size, date}."""

    def __init__(self, root):
        self.root, self.files = root, []  # files: [first_id, day, DayFile]

    def _list(self):
        try:
            names = sorted(n for n in os.listdir(self.root)
                           if n.endswith(".jsonl"))
        except FileNotFoundError:
            return
        for n in names[len(self.files):]:
            df = DayFile(os.path.join(self.root, n))
            df.refresh()
            if df.records:
                self.files.append([df.records[0]["i"], n[:-6], df])

    def count(self):
        self._list()
        if not self.files:
            return 0
        first, _, df = self.files[-1]
        df.refresh()
        return first + len(df.records)

    def _file(self, i):
        for attempt in (0, 1):
            k = bisect.bisect_right([f[0] for f in self.files], i) - 1
            if k >= 0:
                first, _, df = self.files[k]
                if i - first >= len(df.records):
                    df.refresh()
                if i - first < len(df.records):
                    return self.files[k]
            if attempt == 0:
                self._list()
        raise Die("No message #%d." % i)

    def get(self, i):
        if i >= self.count() or i < 0:
            raise Die("No message #%d: the chat holds %d." % (i, self.count()))
        first, _, df = self._file(i)
        return df.records[i - first]

    def day_of(self, i):
        return self._file(i)[1]

    def append(self, items, clock):
        """items = [(kind, text, date or None[, source key])]; returns the
        first id. The key marks a captured message: field "k"."""
        base = self.count()
        recs = []
        for k, (kind, text, date, *src) in enumerate(items):
            recs.append({"i": base + k, "kind": kind, "text": text,
                         "size": nbytes(text), "date": date or clock()})
            if src:
                recs[-1]["k"] = src[0]
        by_file = {}
        for r in recs:
            day = r["date"][:10]
            if self.files and day < self.files[-1][1]:
                day = self.files[-1][1]  # a clock step back stays in order
            by_file.setdefault(day, []).append(r)
        for day, group in by_file.items():
            path = os.path.join(self.root, day + ".jsonl")
            if self.files and self.files[-1][1] == day:
                self.files[-1][2].append(group)
            else:
                DayFile(path).append(group)
                self._list()
        return base


class Tree:
    """tree/YYYY-MM-DD.jsonl: nodes {l, i, text, size}. A node lives in the
    file of the day of its first message, so a lookup reads one small file."""

    def __init__(self, root, main):
        self.root, self.main = root, main
        self.files = {}  # day -> (DayFile, {(l, i): text})

    def _day(self, l, i, fresh=True):
        day = self.main.day_of(i << l)
        if day not in self.files:
            self.files[day] = [DayFile(os.path.join(self.root, day + ".jsonl")),
                               {}, 0]
        entry = self.files[day]
        df, nodes = entry[0], entry[1]
        if fresh:
            df.refresh()
            for r in df.records[entry[2]:]:
                nodes[(r["l"], r["i"])] = r["text"]
            entry[2] = len(df.records)
        return df, nodes

    def get(self, l, i):
        """The node's text, or None if it is not built. A node never
        changes, so a hit needs no read; only a miss looks at the file."""
        try:
            nodes = self._day(l, i, fresh=False)[1]
            if (l, i) not in nodes:
                nodes = self._day(l, i)[1]
            return nodes.get((l, i))
        except Die:  # no such message yet, so the node is not built
            return None

    def put(self, l, i, text):
        df, nodes = self._day(l, i)
        if (l, i) in nodes:
            return False
        df.append([{"l": l, "i": i, "text": text, "size": nbytes(text)}])
        self._day(l, i)
        return True

    def scan(self):
        """Every built node. Only for rebuilding a lost queue file."""
        out = {}
        try:
            names = sorted(os.listdir(self.root))
        except FileNotFoundError:
            return out
        for n in names:
            if n.endswith(".jsonl"):
                df = DayFile(os.path.join(self.root, n))
                for r in df.refresh():
                    out[(r["l"], r["i"])] = r["text"]
        return out


# ------------------------------------------------------------ the view

def line_id(l, i):
    return "%d+%d" % (i << l, 1 << l)


def one_line(text):
    return text.replace("\r", " ").replace("\n", " ")


def merge_down(lines, T, built, size, total, stop):
    """Merge the most due pair of sibling lines until stop(n_lines, total).

    lines: [(l, i)], oldest first. due = (T - last) / 2^l, last being the
    pair's last message; equal dues merge the oldest first. A pair merges
    only when its parent is built (built(l, i) -> bool). size(l, i) is a
    line's bytes. Returns (lines, total, merges)."""
    n = len(lines)
    node = list(lines)
    prev = [k - 1 for k in range(n)]
    nxt = [k + 1 if k + 1 < n else -1 for k in range(n)]
    alive = [True] * n
    heap = []

    def offer(a):
        b = nxt[a] if a >= 0 else -1
        if a < 0 or b < 0:
            return
        (l, i), (l2, i2) = node[a], node[b]
        if l == l2 and i % 2 == 0 and i2 == i + 1 and built(l + 1, i >> 1):
            last = ((i + 2) << l) - 1
            heapq.heappush(heap, (-Fraction(T - last, 1 << l), i << l, a, b,
                                  node[a], node[b]))

    for a in range(n):
        offer(a)
    merges = 0
    while heap and not stop(n - merges, total):
        _, _, a, b, na, nb = heapq.heappop(heap)
        if not (alive[a] and alive[b] and nxt[a] == b
                and node[a] == na and node[b] == nb):
            continue
        l, i = na
        parent = (l + 1, i >> 1)
        total += size(*parent) - size(*na) - size(*nb)
        node[a] = parent
        alive[b] = False
        nxt[a] = nxt[b]
        if nxt[b] >= 0:
            prev[nxt[b]] = a
        merges += 1
        offer(prev[a])
        offer(a)
    return [node[k] for k in range(n) if alive[k]], total, merges


# ------------------------------------------------------------ the store

class State:
    """view.json and queue.json, loaded and saved whole, never rebuilt from
    the log. n counts the messages the state has seen."""

    def __init__(self):
        self.n = 0
        self.chat, self.compact = [], []
        self.chat_merging = self.compact_merging = False
        self.epoch = 0
        self.msgs, self.merges = [], []  # the ready queues


class Store:
    def __init__(self, path, clock=now):
        self.path, self.clock = path, clock
        self.main = Main(os.path.join(path, "main"))
        self.tree = Tree(os.path.join(path, "tree"), self.main)
        self._sizes = {}

    # -- layout
    def p(self, name):
        return os.path.join(self.path, name)

    def exists(self):
        return os.path.isdir(self.path)

    def init(self):
        for d in ("main", "tree"):
            os.makedirs(self.p(d), exist_ok=True)

    @contextmanager
    def writer(self, timeout=None):
        """The one writer lock. Every change to the store happens inside.
        With a timeout (seconds) it raises Busy instead of waiting longer."""
        lock = open(self.p(".lock"), "a")
        if timeout is None:
            fcntl.flock(lock, fcntl.LOCK_EX)
        else:
            end = time.time() + timeout
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.time() >= end:
                        lock.close()
                        raise Busy()
                    time.sleep(0.02)
        try:
            yield
        finally:
            lock.close()

    # -- state
    def load(self):
        s = State()
        try:
            with open(self.p("view.json"), encoding="utf-8") as f:
                v = json.load(f)
            s.n, s.epoch = v["n"], v.get("epoch", 0)
            s.chat = [tuple(x) for x in v["view"]]
            s.compact = [tuple(x) for x in v["compact"]]
            s.chat_merging = v.get("merging", False)
            s.compact_merging = v.get("compact_merging", False)
        except FileNotFoundError:
            pass
        try:
            with open(self.p("queue.json"), encoding="utf-8") as f:
                q = json.load(f)
            s.msgs = list(q["msgs"])
            s.merges = [tuple(x) for x in q["merges"]]
        except FileNotFoundError:
            if s.n:
                self.rebuild_queues(s)
        return s

    def save(self, s):
        for name, obj in (
                ("queue.json", {"msgs": s.msgs, "merges": s.merges}),
                ("view.json", {"n": s.n, "epoch": s.epoch, "view": s.chat,
                               "merging": s.chat_merging, "compact": s.compact,
                               "compact_merging": s.compact_merging})):
            tmp = self.p(name + ".tmp")
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(obj, f, separators=(",", ":"))
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, self.p(name))

    def rebuild_queues(self, s):
        """Only when queue.json is lost: one scan of the tree."""
        built = self.tree.scan()
        s.msgs = [i for i in range(s.n) if (0, i) not in built]
        s.merges = sorted(
            ((l + 1, i >> 1) for (l, i) in built
             if i % 2 == 0 and (l, i + 1) in built
             and (l + 1, i >> 1) not in built),
            key=lambda k: (k[1] << k[0]) + (1 << k[0]))

    # -- lines
    def built(self, l, i):
        return self.tree.get(l, i) is not None

    def render(self, l, i):
        text = self.tree.get(l, i)
        return "%s|%s" % (line_id(l, i),
                          PLACEHOLDER if text is None else one_line(text))

    def size(self, l, i):
        text = self.tree.get(l, i)
        if text is None:
            return nbytes(line_id(l, i)) + 1 + nbytes(PLACEHOLDER) + 1
        key = (l, i)
        if key not in self._sizes:
            self._sizes[key] = nbytes(line_id(l, i)) + 1 + nbytes(text) + 1
        return self._sizes[key]

    # -- the writer's operations; the caller holds the lock
    def add_messages(self, items):
        base = self.main.append(items, self.clock)
        self.catch_up()
        return base

    def catch_up(self):
        """Give every message the state has not seen its node and its view
        line. Also the repair after a crash between the log and the state."""
        s = self.load()
        T = self.main.count()
        while s.n < T:
            self._add(s, s.n)
        self.save(s)

    def _add(self, s, j):
        m = self.main.get(j)
        source = "%s: %s" % (m["kind"], m["text"])
        if nbytes(source) <= NODE_MAX:
            self.tree.put(0, j, source)
            self._built(s, 0, j)
        elif j not in s.msgs:
            s.msgs.append(j)
        s.chat.append((0, j))
        s.compact.append((0, j))
        s.n = j + 1
        self.settle(s)

    def _built(self, s, l, i):
        """After a node is built: queue or build its parent. A parent that
        fits in 512 bytes is its halves joined, with no model call."""
        sib = self.tree.get(l, i ^ 1)
        if sib is None:
            return
        parent = (l + 1, i >> 1)
        if self.built(*parent):
            return
        a, b = self.tree.get(l, i & ~1), self.tree.get(l, i | 1)
        joined = a + "\n" + b
        if nbytes(joined) <= NODE_MAX:
            self.tree.put(*parent, joined)
            self._built(s, *parent)
        elif parent not in s.merges:
            s.merges.append(parent)

    def commit(self, key, text):
        """Store a built node and queue what it makes ready."""
        with self.writer():
            self.commit_locked(key, text)

    def commit_locked(self, key, text):
        """commit, for a caller that holds the writer lock."""
        self.catch_up()
        s = self.load()
        l, i = key
        if l == 0:
            s.msgs = [j for j in s.msgs if j != i]
        else:
            s.merges = [k for k in s.merges if k != key]
        self.tree.put(l, i, text)
        self._built(s, l, i)
        self.settle(s)
        self.save(s)

    def settle(self, s):
        """The sawtooth: above the high mark one batch merges the most due
        pairs down to the low mark; if parents are missing it goes on at
        the next message or built node."""
        T = s.n
        total = sum(self.size(*k) for k in s.chat)
        if not s.chat_merging and total > VIEW_HI:
            s.chat_merging = True
        merged = 0
        if s.chat_merging:
            s.chat, total, merged = merge_down(
                s.chat, T, self.built, self.size, total,
                lambda n, t: t <= VIEW_LO)
            s.chat_merging = total > VIEW_LO
            if merged:
                s.epoch += 1
        ctotal = sum(self.size(*k) for k in s.compact)
        if not s.compact_merging and (ctotal > CVIEW_HI or merged):
            s.compact_merging = True
        if s.compact_merging:
            s.compact, ctotal, _ = merge_down(
                s.compact, T, self.built, self.size, ctotal,
                lambda n, t: t <= CVIEW_LO)
            s.compact_merging = ctotal > CVIEW_LO

    def compaction_view(self, s, end):
        """Lines of the compaction view before message `end`, up to the
        first unbuilt line."""
        out = []
        for l, i in s.compact:
            if (i << l) >= end or not self.built(l, i):
                break
            out.append(self.render(l, i))
        return out


# ------------------------------------------------------------ messages

def split_text(text):
    """Cut a long text into messages of at most MESSAGE_MAX bytes. Joined
    again they give the text word for word."""
    parts, rest = [], text
    while nbytes(rest) > MESSAGE_MAX:
        cut = rest.encode()[:MESSAGE_MAX].decode("utf-8", "ignore")
        nl = cut.rfind("\n")
        if nl > len(cut) * 3 // 4:
            cut = cut[:nl + 1]
        parts.append(cut)
        rest = rest[len(cut):]
    return parts + [rest]


def clip_echo(text):
    if len(text) <= ECHO_MAX:
        return text
    mark = "\n[... %d characters clipped ...]\n" % (len(text) - ECHO_MAX)
    keep = ECHO_MAX - len(mark)
    return text[:keep // 2] + mark + text[len(text) - (keep - keep // 2):]


def make_items(kind, text, date=None):
    if kind == "echo":
        text = clip_echo(text)
    return [(kind, part, date) for part in split_text(text)]


# ------------------------------------------------------------ the model

def render_blocks(chat_lines, task):
    """The request body after the system prompt, as cache blocks: the view
    in blocks of BLOCK lines, a mark on the last whole block, a mark on the
    end."""
    nb = len(chat_lines) // BLOCK
    blocks = []
    for b in range(nb):
        text = "\n".join(chat_lines[b * BLOCK:(b + 1) * BLOCK]) + "\n"
        blocks.append({"type": "text",
                       "text": ("<chat>\n" if b == 0 else "") + text})
    if blocks:
        blocks[-1]["cache_control"] = {"type": "ephemeral"}
    rest = chat_lines[nb * BLOCK:]
    tail = ("<chat>\n" if not nb else "") + "".join(x + "\n" for x in rest)
    blocks.append({"type": "text", "text": tail + "</chat>\n" + task,
                   "cache_control": {"type": "ephemeral"}})
    return blocks


